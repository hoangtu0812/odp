# PostgreSQL local lab. Copy to .env and replace the development password.
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_PORT=5432

# dbt connection settings
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=platform_admin
DBT_PASSWORD=change-me-before-running
DBT_DATABASE=dwh

# Local-only Airflow configuration. Replace all values before any shared deployment.
AIRFLOW_FERNET_KEY=MDEyMzQ1Njc4OWFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHg=
AIRFLOW_API_SECRET_KEY=local-lab-only-api-secret-change-before-shared-use-0123456789abcdef0123456789abcdef
AIRFLOW_JWT_SECRET=local-lab-only-jwt-secret-change-before-shared-use-0123456789abcdef0123456789abcdef
AIRFLOW_PORT=8080

# Maximo Work Order ingestion. Keep disabled until the endpoint and the OSLc
# object structure have been validated with the source-system owner.
MAXIMO_BASE_URL=https://maximo.example.com/maximo
MAXIMO_USER=replace-me
MAXIMO_PASS=replace-me
MAXIMO_API_STYLE=rest_mbo
MAXIMO_WORKORDER_PATH=/rest/mbo/workorder/
MAXIMO_AUTH_MODE=maxauth
# Optional: explicit base64 maxauth header value. When omitted, the connector
# derives it from MAXIMO_USER and MAXIMO_PASS without writing it to disk.
# MAXIMO_MAXAUTH=
MAXIMO_INCREMENTAL_FIELD=changedate
MAXIMO_PAGE_SIZE=100
MAXIMO_VERIFY_TLS=true
MAXIMO_INGEST_ENABLED=false
# Required for a REST MBO initial load unless an approved full snapshot is
# explicitly allowed. Choose the business retention date with the data owner.
# MAXIMO_INITIAL_SYNC_SINCE=2026-01-01T00:00:00+07:00
# MAXIMO_ALLOW_FULL_SNAPSHOT=false

# Superset local administration (the application is granted only mart read access).
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=platform-admin@localhost
SUPERSET_ADMIN_PASSWORD=change-me-before-running
SUPERSET_SECRET_KEY=local-development-only-change-before-shared-use

# Data Platform Portal local launcher
PORTAL_PORT=3000

# Local observability. Grafana credentials must be replaced before any shared use.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-running
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# Local lakehouse services. Replace the defaults in any shared environment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-before-running
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TRINO_PORT=8081
ICEBERG_REST_PORT=8181

# Governance Local Lab
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-before-running
OPA_PORT=8182
AI_SERVICE_PORT=8010
AIRBYTE_PORT=8001
OPENMETADATA_PORT=8585
OPENMETADATA_INGESTION_PORT=8084
OPENMETADATA_POSTGRES_PORT=5433

# Microsoft Entra ID broker configuration. Register the Keycloak broker
# redirect URI in Entra before enabling sign-in.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
